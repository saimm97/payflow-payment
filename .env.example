# NextAuth — copy to .env or .env.local and set values
# NEXTAUTH_URL=http://localhost:3000
# Generate a secret: openssl rand -base64 32
# NEXTAUTH_SECRET=your-generated-secret-here

# Stripe (payment gateway) — get keys from https://dashboard.stripe.com/apikeys
# When set, the app uses Stripe for real card payments; otherwise demo mode is used.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# For webhooks (payment_intent.succeeded): stripe listen --forward-to localhost:3000/api/webhooks/stripe
# STRIPE_WEBHOOK_SECRET=whsec_...
